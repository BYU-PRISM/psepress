\newcommand{\HeaderArticleType}{Original Research Article}
\newcommand{\HeaderReviewType}{Peer Reviewed Conference Proceeding}
\newcommand{\HeaderConference}{ESCAPE 37 - European Symposium on Computer Aided Process Engineering}
\newcommand{\HeaderLocation}{Trondheim, Norway, 6-9 June 2027}
\newcommand{\FooterJournalInfo}{Syst Control Trans V:XXXX-YYYY (2027)}
\newcommand{\FirstPageFooterID}{[DOI\_DoNotChange]}
\newcommand{\BodyPageFooterID}{[LAPSE\_DoNotChange]}

\newcommand{\PSESetConference}[2]{%
  \renewcommand{\HeaderConference}{#1}%
  \renewcommand{\HeaderLocation}{#2}%
}

\makeatletter
\expandafter\def\csname pseconference@escape-37-2027\endcsname{%
  \PSESetConference
    {ESCAPE 37 - European Symposium on Computer Aided Process Engineering}%
    {Trondheim, Norway, 6-9 June 2027}%
}
\expandafter\def\csname pseconference@pse-2027\endcsname{%
  \PSESetConference
    {PSE 2027 – Process Systems Engineering}%
    {Mexico City, Mexico, 13-17 June 2027}%
}
\expandafter\def\csname pseconference@focapo-cpc-2027\endcsname{%
  \PSESetConference
    {FOCAPO-CPC 2027}%
    {Tucson, Arizona, USA, 10-14 January 2027}%
}
\newcommand{\PSESelectConference}[1]{%
  \@ifundefined{pseconference@#1}{%
    \PackageError{psepress}{Unknown conference preset `#1'}%
      {Use escape-37-2027, pse-2027, focapo-cpc-2027, or \string\PSESetConference.}%
  }{%
    \csname pseconference@#1\endcsname
  }%
}
\makeatother

\newcommand{\psefirstpagefooterid}[1]{{\psefooterfont\color{PSEBlue}#1}}
\newcommand{\psebodypagefooterid}[1]{{\psefooterfont\bfseries#1}}
\newcommand{\psefooterjournal}{{\psefooterfont\bfseries\FooterJournalInfo}}
\newcommand{\psefooterpage}{{\psefooterfont\bfseries\thepage}}

\newcommand{\pseconfigurefancywidths}{%
  \fancyheadoffset[L,R]{0pt}%
  \fancyfootoffset[L,R]{0pt}%
  \setlength{\headwidth}{\textwidth}%
}

\newcommand{\psefootrule}{%
  {\color{PSEGray}\hrule height 0.4pt width \headwidth\relax}%
  \vskip2pt
}

\newcommand{\pseapplyarticlefooterstyle}[2]{%
  \fancyhf{}%
  \fancyhead{}%
  \pseconfigurefancywidths
  \fancyfoot[L]{#1{#2}}%
  \fancyfoot[C]{\psefooterjournal}%
  \fancyfoot[R]{\psefooterpage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0.4pt}%
  \renewcommand{\footrule}{\psefootrule}%
}

\newcommand{\pseapplyreviewpagestyle}{%
  \fancyhf{}%
  \fancyhead{}%
  \pseconfigurefancywidths
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\newcommand{\psearticleleftheader}{%
  \begin{minipage}[b]{5.78cm}%
    \includegraphics[width=5.78cm]{systems-control-transactions.png}%
  \end{minipage}%
}

\newcommand{\psearticleheadermetadata}{%
  \begin{minipage}[b]{4.55cm}%
    \raggedleft
    {\psefooterfont\bfseries \HeaderArticleType\par}%
    {\psefooterfont\itshape \HeaderReviewType\par}%
    {\psefooterfont \HeaderConference\par}%
    {\psefooterfont \HeaderLocation\par}%
  \end{minipage}%
}

\newcommand{\psearticlerightheader}{%
  \begin{minipage}[b]{6.2cm}%
    \raggedleft
    \psearticleheadermetadata\hspace{0.22cm}%
    \raisebox{\psearticlepressraise}[0pt][0pt]{\includegraphics[width=1.11cm]{pse-press.png}}%
  \end{minipage}%
}

\newcommand{\psearticleheaderblock}{%
  \noindent
  \begin{minipage}[t]{\textwidth}%
    \noindent
    \begin{minipage}[t]{5.78cm}%
      \includegraphics[width=5.78cm]{systems-control-transactions.png}%
    \end{minipage}%
    \hfill
    \raisebox{-\psearticleheaderrightdrop}[0pt][0pt]{\psearticlerightheader}%
  \end{minipage}\par
}

\fancypagestyle{psearticlefirstpage}{%
  \pseapplyarticlefooterstyle{\psefirstpagefooterid}{\FirstPageFooterID}
}

\fancypagestyle{psearticlebody}{%
  \pseapplyarticlefooterstyle{\psebodypagefooterid}{\BodyPageFooterID}
}

\fancypagestyle{psereview}{%
  \pseapplyreviewpagestyle
}

\fancypagestyle{plain}{%
  \ifpsereviewmode
    \pseapplyreviewpagestyle
  \else
    \pseapplyarticlefooterstyle{\psebodypagefooterid}{\BodyPageFooterID}
  \fi
}

\newcommand{\psearticleabstractblock}{%
  \begin{center}
    \begin{minipage}{\dimexpr\textwidth-\pseabstractwidthreduction\relax}
      \hrule height 0.5pt
      \vspace{8pt}
      {\pseabstractheadfont\MakeUppercase{Abstract}\par}
      \vspace{4pt}
      \noindent\justifying
      \PaperAbstract\par
      \vspace{6pt}
      \hrule height 0.5pt
      \vspace{6pt}
      {\psekeywordsfont Keywords: \PaperKeywords\par}
    \end{minipage}
  \end{center}
}

\newcommand{\psereviewabstractblock}{%
  \noindent{\pseabstractheadfont\MakeUppercase{Abstract}\par}
  \vspace{4pt}
  \noindent\justifying
  \PaperAbstract\par
  \vspace{8pt}
  {\psekeywordsfont\noindent Keywords: \PaperKeywords\par}
}

\newcommand{\pseabstractblock}{%
  \ifpsereviewmode
    \psereviewabstractblock
  \else
    \psearticleabstractblock
  \fi
}

\newcommand{\pseactivatearticlebodygeometry}{}

\newcommand{\psereviewstartlinenumbers}{%
  \ifpsereviewmode
    \setlength{\linenumbersep}{0.65cm}%
    \renewcommand{\linenumberfont}{\normalfont\fontsize{7}{7}\selectfont\color{PSEGray}}%
    \modulolinenumbers[1]%
    \linenumbers
  \fi
}

\newcommand{\psearticlemaketitle}{%
  \twocolumn[{%
    \vspace*{\dimexpr\psearticlefirstpagetexttop-\psearticletopmargin-12pt\relax}%
    \thispagestyle{psearticlefirstpage}%
    \begin{minipage}[t]{\textwidth}
      \psearticleheaderblock
      \vspace{\psearticleheadertotitlesep}
      {\psetitlefont\PaperTitle\par}
      \vspace{12pt}
      {\pseauthorfont\PaperAuthors\par}
      \vspace{6pt}
      {\pseaffilfont\PaperAffiliations\par}
      \vspace{8pt}
      \pseabstractblock
      \vspace{12pt}
    \end{minipage}
  }]%
  \thispagestyle{psearticlefirstpage}%
  \pseactivatearticlebodygeometry
  \pagestyle{psearticlebody}%
}

\newcommand{\psereviewmaketitle}{%
  \thispagestyle{psereview}%
  {\centering
    {\psetitlefont\PaperTitle\par}
    \vspace{12pt}
    {\pseauthorfont\PaperAuthors\par}
    \vspace{8pt}
    {\pseaffilfont\PaperAffiliations\par}
    \par
  }%
  \vspace{14pt}
  \psereviewstartlinenumbers
  \pseabstractblock
  \vspace{12pt}
}

\newcommand{\psemaketitle}{%
  \ifpsereviewmode
    \psereviewmaketitle
  \else
    \psearticlemaketitle
  \fi
}

\newenvironment{psedefinition}[1]{%
  \par\vspace{6pt}%
  {\noindent\bfseries\fontsize{10}{11}\selectfont #1\par}%
  \vspace{2pt}%
  \begin{list}{}{\leftmargin=0.425cm\rightmargin=0.425cm}%
    \item\relax\color{PSEBlue}\justifying
}{%
  \end{list}%
}

\newcommand{\psecopyright}[1]{%
  \par
  \begin{samepage}
    \vspace{6pt}%
    \noindent\hrule height 0.5pt\relax
    \vspace{4pt}%
    {\psecopyrightfont\justifying #1\par}%
    \vspace{4pt}%
    {\noindent\includegraphics[width=2.43cm]{cc-by-sa.png}\par}%
  \end{samepage}
}

\newcommand{\pseprintcopyright}{%
  \ifpsereviewmode
    \relax
  \else
    \psecopyright{\PaperCopyrightText}%
  \fi
}

\newcommand{\pseprintreferences}{%
  \ifpsereviewmode\else\balance\fi
  \section{References}
  \printbibliography[heading=none]
}

\AtBeginDocument{%
  \ifpsereviewmode
    \pagestyle{psereview}%
    \onehalfspacing
    \raggedbottom
  \else
    \pagestyle{psearticlebody}%
  \fi
}
