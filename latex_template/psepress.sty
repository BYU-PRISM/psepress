\newcommand{\psearticleleftmargin}{2.1cm}
\newcommand{\psearticlerightmargin}{2.1cm}
\newcommand{\psearticletopmargin}{2.1cm}
\newcommand{\psearticlebottommargin}{3.1cm}
\newcommand{\psearticlefooteroffset}{2.3cm}
\newcommand{\psearticlefirstpagetexttop}{2.5cm}
\newcommand{\psearticleheaderrightdrop}{0.2cm}
\newcommand{\psearticleheadertotitlesep}{0.65cm}
\newcommand{\psearticlepressraise}{0.10cm}
\newcommand{\pseabstractwidthreduction}{1.70cm}

\newcommand{\psearticlegeometry}{%
  \geometry{
    left=\psearticleleftmargin,
    right=\psearticlerightmargin,
    top=\psearticletopmargin,
    bottom=\psearticlebottommargin,
    includefoot,
    headheight=14pt,
    headsep=10pt,
    footskip=\psearticlefooteroffset
  }%
}

\newcommand{\psereviewgeometry}{%
  \geometry{
    left=2.54cm,
    right=2.54cm,
    top=2.54cm,
    bottom=2.54cm,
    headheight=12pt,
    headsep=14pt,
    footskip=1.2cm
  }%
}

\ifpsereviewmode
  \psereviewgeometry
\else
  \psearticlegeometry
\fi

\graphicspath{{media/}}
\urlstyle{same}

\definecolor{PSEBlue}{HTML}{00509E}
\definecolor{PSEGray}{HTML}{A6A6A6}
\definecolor{PSEDark}{HTML}{111111}

\hypersetup{
  colorlinks=true,
  linkcolor=PSEBlue,
  citecolor=PSEBlue,
  urlcolor=PSEBlue
}

\setmainfont{Inter-Regular}[
  Path=fonts/,
  Extension=.ttf,
  UprightFont=*,
  BoldFont=Inter-Bold,
  ItalicFont=Inter-Italic
]
\newfontfamily\intermedium{Inter-Medium}[Path=fonts/,Extension=.ttf]
\setmonofont{CourierNew}[Path=fonts/,Extension=.ttf]
\setmathfont{CambriaMath}[Path=fonts/,Extension=.ttf]

\setlength{\columnsep}{0.586cm}
\setlength{\parindent}{0.425cm}
\setlength{\parskip}{0pt}
\setlength{\textfloatsep}{12pt}
\setlength{\intextsep}{12pt}
\setlength{\abovecaptionskip}{6pt}
\setlength{\belowcaptionskip}{0pt}
\setlength{\bibitemsep}{0pt}
\setlength{\bibhang}{0.425cm}
\clubpenalty=0
\widowpenalty=0
\displaywidowpenalty=0
\emergencystretch=2em
\Urlmuskip=0mu plus 2mu

\makeatletter
\renewcommand\normalsize{%
  \@setfontsize\normalsize{9pt}{11pt}%
  \abovedisplayskip 9pt plus 2pt minus 4pt%
  \abovedisplayshortskip \z@ plus 2pt%
  \belowdisplayshortskip 5pt plus 2pt minus 3pt%
  \belowdisplayskip \abovedisplayskip
  \let\@listi\@listI
}
\makeatother
\normalsize

\DeclareCaptionFont{psecaption}{\fontsize{9}{11}\selectfont}
\captionsetup{
  font=psecaption,
  labelfont=normalfont,
  textfont=normalfont,
  justification=justified,
  singlelinecheck=false
}
\captionsetup[figure]{labelsep=period}
\captionsetup[table]{labelsep=colon}

\lstdefinestyle{psecode}{
  basicstyle=\ttfamily\fontsize{9}{12}\selectfont,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  frame=none,
  xleftmargin=0pt,
  aboveskip=6pt,
  belowskip=0pt
}

\setcounter{secnumdepth}{0}

\titleformat{\section}
  {\intermedium\fontsize{12}{13}\selectfont\color{PSEBlue}}
  {}
  {0pt}
  {\MakeUppercase}
\titlespacing*{\section}{0pt}{12pt}{2pt}

\titleformat{\subsection}
  {\intermedium\fontsize{11}{12}\selectfont\color{PSEBlue}}
  {}
  {0pt}
  {}
\titlespacing*{\subsection}{0pt}{6pt}{2pt}

\titleformat{\subsubsection}
  {\intermedium\fontsize{10}{11}\selectfont\color{PSEBlue}}
  {}
  {0pt}
  {}
\titlespacing*{\subsubsection}{0pt}{4pt}{2pt}

\titleformat{\paragraph}[block]
  {\fontsize{10}{11}\selectfont\color{PSEBlue}}
  {}
  {0pt}
  {}
\titlespacing*{\paragraph}{0pt}{4pt}{0pt}

\newcommand{\psetitlefont}{\fontsize{18}{22}\selectfont}
\newcommand{\pseauthorfont}{\bfseries\fontsize{10}{12}\selectfont\color{PSEBlue}}
\newcommand{\pseaffilfont}{\fontsize{8}{11}\selectfont}
\newcommand{\pseabstractheadfont}{\intermedium\fontsize{12}{13}\selectfont\color{PSEBlue}}
\newcommand{\psekeywordsfont}{\fontsize{8}{10}\selectfont}
\newcommand{\psefooterfont}{\fontsize{8}{9}\selectfont\color{PSEDark}}
\newcommand{\psecopyrightfont}{\fontsize{8}{10}\selectfont}

\newcommand{\PaperTitle}{Place Your Paper Title Here with Title Capitalization that May Run Multiple Lines}
\newcommand{\PaperAuthors}{%
Firstname Q.~Lastname\textsuperscript{a},
Givenname R.~S.~Surname Jr.\textsuperscript{ab},
and Personwith MULTIWORD LASTNAME\textsuperscript{b*}}
\newcommand{\PaperAffiliations}{%
\textsuperscript{a} Provincial University, Department of Chemical Engineering, City, Province, Country\\
\textsuperscript{b} State College, Engineering Department, City, State, Country\\
\textsuperscript{*} Corresponding Author: \href{mailto:author.email@someuniversity.ca}{author.email@someuniversity.ca}}
